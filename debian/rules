#!/usr/bin/make -f

INSTALL_PREFIX ?= /opt/roboparty
# Where the standalone serial dependency is installed. Defaults to the package
# prefix; can be pointed at an extracted ros-jazzy-serial tree for CI builds.
DEPS_PREFIX ?= $(INSTALL_PREFIX)
export DH_VERBOSE = 1
export DEB_BUILD_MAINT_OPTIONS = optimize=-lto
ROS_DISTRO ?= jazzy
ROS_SETUP ?= /opt/ros/$(ROS_DISTRO)
export ROS_DISTRO
export ROS_SETUP
export AMENT_PREFIX_PATH = $(ROS_SETUP):$(DEPS_PREFIX)
export CMAKE_PREFIX_PATH = $(ROS_SETUP):/usr:$(DEPS_PREFIX)
export LD_LIBRARY_PATH := $(ROS_SETUP)/lib:$(DEPS_PREFIX)/lib$(if $(LD_LIBRARY_PATH),:$(LD_LIBRARY_PATH))
export CCACHE_DISABLE = 1

JOBS ?= $(shell nproc)
PKG_NAME = nlink-parser-ros2
STAGE := $(CURDIR)/build/stage$(INSTALL_PREFIX)

%:
	dh $@

override_dh_auto_configure:
	. $(ROS_SETUP)/setup.sh && colcon build \
		--base-paths . \
		--packages-up-to nlink_parser_ros2 \
		--parallel-workers $(JOBS) \
		--build-base build/colcon \
		--install-base "$(STAGE)" \
		--merge-install \
		--cmake-args \
			-DCMAKE_BUILD_TYPE=Release \
			-DBUILD_TESTING=OFF \
			-DCMAKE_PREFIX_PATH="$(ROS_SETUP):/usr:$(DEPS_PREFIX)" \
			-DCMAKE_LIBRARY_PATH="/usr/lib:$(DEPS_PREFIX)/lib" \
			-DCMAKE_INCLUDE_PATH="/usr/include:$(DEPS_PREFIX)/include"

override_dh_auto_build:
	@true

override_dh_auto_install:
	# Copy only the package payload; colcon's root scaffolding would clobber
	# $(INSTALL_PREFIX)/setup.bash and the shared ament index.
	install -d debian/$(PKG_NAME)$(INSTALL_PREFIX)/bin
	install -d debian/$(PKG_NAME)$(INSTALL_PREFIX)/include
	install -d debian/$(PKG_NAME)$(INSTALL_PREFIX)/lib
	install -d debian/$(PKG_NAME)$(INSTALL_PREFIX)/share/ament_index
	cp -a build/stage$(INSTALL_PREFIX)/bin/. debian/$(PKG_NAME)$(INSTALL_PREFIX)/bin/
	cp -a build/stage$(INSTALL_PREFIX)/include/. debian/$(PKG_NAME)$(INSTALL_PREFIX)/include/
	cp -a build/stage$(INSTALL_PREFIX)/lib/. debian/$(PKG_NAME)$(INSTALL_PREFIX)/lib/
	cp -a build/stage$(INSTALL_PREFIX)/share/ament_index/. \
		debian/$(PKG_NAME)$(INSTALL_PREFIX)/share/ament_index/
	for pkg in nlink_parser_ros2 nlink_parser_ros2_interfaces; do \
		cp -a build/stage$(INSTALL_PREFIX)/share/$$pkg \
			debian/$(PKG_NAME)$(INSTALL_PREFIX)/share/; \
	done

override_dh_auto_clean:
	rm -rf build log

override_dh_shlibdeps:
	dh_shlibdeps -- -l$(CURDIR)/build/stage$(INSTALL_PREFIX)/lib \
		-l$(DEPS_PREFIX)/lib --ignore-missing-info
